NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key. This is not a server secret.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Default false; enable only where inventory callables and acceptance checks are deployed.
NEXT_PUBLIC_ENABLE_INVENTORY=false

# Kakao Maps JavaScript key (public, domain-restricted; NOT the REST API secret).
# Enable Maps and register https://onnuriway.com in Kakao Developers.
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=

# Server-only Admin CLI approval. Never prefix with NEXT_PUBLIC_.
ALLOW_LIVE_SEARCH_CATALOG_PUBLISH=false
