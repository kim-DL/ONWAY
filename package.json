{
  "name": "onnuriway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13 <23"
  },
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace functions",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:neis": "vitest run functions/tests/neis-initial-import.test.ts",
    "test:neis:emulator": "node scripts/firebase-emulators.mjs phase5",
    "test:search": "vitest run src/features/search",
    "test:search:emulator": "node scripts/firebase-emulators.mjs phase6",
    "test:field": "vitest run functions/tests/field-profile-service.test.ts src/domain/phase1-contract.test.ts",
    "test:field:emulator": "node scripts/firebase-emulators.mjs phase7",
    "test:photo": "vitest run functions/tests/photo-processor.test.ts src/domain/phase1-contract.test.ts",
    "test:photo:emulator": "node scripts/firebase-emulators.mjs phase8",
    "test:sales": "vitest run functions/tests/sales-cycle-service.test.ts src/domain/phase1-contract.test.ts",
    "test:sales:emulator": "node scripts/firebase-emulators.mjs phase9",
    "test:visit": "vitest run functions/tests/sales-visit-service.test.ts src/features/sales-visit/sales-visit-contract.test.ts src/domain/phase1-contract.test.ts",
    "test:visit:emulator": "node scripts/firebase-emulators.mjs phase10",
    "test:history": "vitest run functions/tests/sales-profile-service.test.ts src/features/sales-history/sales-history-contract.test.ts src/domain/phase1-contract.test.ts",
    "test:history:emulator": "node scripts/firebase-emulators.mjs phase11",
    "test:export": "vitest run functions/tests/csv-export.test.ts src/features/export/csv-export-contract.test.ts src/domain/phase1-contract.test.ts",
    "test:export:emulator": "node scripts/firebase-emulators.mjs phase12",
    "test:sync": "vitest run functions/tests/neis-sync.test.ts functions/tests/kakao-matcher.test.ts src/features/school-detail/kakao-directions.test.ts",
    "test:sync:emulator": "node scripts/firebase-emulators.mjs phase13",
    "test:pwa": "vitest run src/features/pwa src/lib/app-metadata.test.ts",
    "test:admin": "vitest run src/features/admin functions/tests/pin-crypto.test.ts functions/tests/login-service.test.ts",
    "test:admin:emulator": "node scripts/firebase-emulators.mjs phase15",
    "test:performance": "vitest run src/lib/performance src/features/search && tsx scripts/run-phase16-performance-gate.ts",
    "verify:pwa:build": "node scripts/verify-phase14-build.mjs",
    "verify:performance:build": "node scripts/verify-phase16-performance-build.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "test:e2e:phase13": "node scripts/firebase-emulators.mjs phase13e2e",
    "test:e2e:phase13:focus": "node scripts/firebase-emulators.mjs phase13focus",
    "test:e2e:phase16": "node scripts/firebase-emulators.mjs phase16e2e",
    "test:rules": "node scripts/firebase-emulators.mjs rules",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:e2e": "tsx scripts/run-app-shell-e2e.ts",
    "test:e2e:auth": "node scripts/firebase-emulators.mjs phase3",
    "test:e2e:phase4": "node scripts/firebase-emulators.mjs phase4",
    "test:e2e:phase6": "node scripts/firebase-emulators.mjs phase6e2e",
    "test:e2e:phase7": "node scripts/firebase-emulators.mjs phase7e2e",
    "test:e2e:phase8": "node scripts/firebase-emulators.mjs phase8e2e",
    "test:e2e:phase9": "node scripts/firebase-emulators.mjs phase9e2e",
    "test:e2e:phase9:focus": "node scripts/firebase-emulators.mjs phase9focus",
    "test:e2e:phase10": "node scripts/firebase-emulators.mjs phase10e2e",
    "test:e2e:phase10:focus": "node scripts/firebase-emulators.mjs phase10focus",
    "test:e2e:phase11": "node scripts/firebase-emulators.mjs phase11e2e",
    "test:e2e:phase11:focus": "node scripts/firebase-emulators.mjs phase11focus",
    "test:e2e:phase12": "node scripts/firebase-emulators.mjs phase12e2e",
    "test:e2e:phase12:focus": "node scripts/firebase-emulators.mjs phase12focus",
    "test:e2e:auth:run": "playwright test --config playwright.phase3.config.ts",
    "functions:build": "npm run build --workspace functions",
    "neis:import:fixture": "npm run functions:build && node functions/lib/neis/import-cli.js --fixture scripts/fixtures/neis-school-info.json",
    "search:catalog:publish": "tsx scripts/publish-search-catalog.ts",
    "emulators": "node scripts/firebase-emulators.mjs start",
    "seed": "tsx scripts/seed-emulator.ts",
    "seed:verify": "node scripts/firebase-emulators.mjs seed",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "@serwist/window": "^9.5.12",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "serwist": "^9.5.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
